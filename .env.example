# =============================================================================
# VARIABLES DE ENTORNO - MESA DE AYUDA OTIC UNALM
# =============================================================================

# Configuración del Servidor Node.js
PORT=4000
NODE_ENV=production
API_PREFIX=/api

# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_mysql
DB_PASSWORD=tu_password_seguro_aqui
DB_PASS=tu_password_seguro_aqui
DB_NAME=mesaayuda_db
DB_CONNECTION_LIMIT=20

# Autenticación JWT y Seguridad
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_cambiar_en_produccion
JWT_EXPIRES_IN=24h

# Almacenamiento de Archivos Adjuntos (/var/www/mesa-ayuda/uploads/)
UPLOAD_DIR=/var/www/mesa-ayuda/uploads
MAX_FILE_SIZE_BYTES=10485760 # 10MB limit

# Dominio Institucional
ALLOWED_ORIGIN=*
APP_URL=https://mesaayuda.lamolina.edu.pe

# Configuración Notificador de Correo SMTP (Google Workspace / Servidor SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones.mesadeayuda@lamolina.edu.pe
SMTP_PASS=tu_app_password_aqui
SMTP_FROM="Mesa de Ayuda OTIC UNALM <notificaciones.mesadeayuda@lamolina.edu.pe>"
MESA_AYUDA_EMAIL=notificaciones.mesadeayuda@lamolina.edu.pe

# =============================================================================
# Configuración Autenticación Directorio Activo (Active Directory / LDAP - UNALM)
# Datos requeridos del Administrador de Redes / Infraestructura OTIC:
# =============================================================================
# Habilitar/Deshabilitar autenticación LDAP institucional (true | false)
LDAP_ENABLED=true

# URL o IP del Domain Controller de Active Directory (ej. ldap://172.16.0.10:389 o con SSL ldaps://172.16.0.10:636)
LDAP_URL=ldap://172.16.0.10:389

# Base DN del árbol de directorio de la universidad
LDAP_BASE_DN=DC=lamolina,DC=edu,DC=pe

# Dominio corporativo de la UNALM
LDAP_DOMAIN=lamolina.edu.pe

# Usuario de servicio con permisos de consulta en AD (Bind User)
# Puede ser en formato DN (ej: CN=svc_mesaayuda,OU=ServiceAccounts,DC=lamolina,DC=edu,DC=pe)
# O formato UPN (ej: svc_mesaayuda@lamolina.edu.pe) o NT (ej: LAMOLINA\svc_mesaayuda)
LDAP_BIND_DN=CN=svc_mesaayuda,OU=ServiceAccounts,DC=lamolina,DC=edu,DC=pe

# Contraseña del usuario de servicio de Active Directory
LDAP_BIND_PASSWORD=password_cuenta_servicio_aqui

# Timeout en milisegundos para consultas LDAP (por defecto 5000ms = 5 segundos)
LDAP_TIMEOUT_MS=5000

