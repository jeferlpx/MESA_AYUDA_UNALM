# =============================================================================
# VARIABLES DE ENTORNO - SISTEMA DE MESA DE AYUDA Y GESTIÓN DE SERVICIOS
# Plantilla base para despliegue en entornos de producción, pruebas y desarrollo
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Configuración del Servidor Node.js (Backend API)
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
API_PREFIX=/api

# -----------------------------------------------------------------------------
# 2. Conexión a Base de Datos Relacional (MySQL 8.0+ / MariaDB 10.5+)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_base_datos
DB_PASSWORD=tu_password_seguro_aqui
# Alternativa compatible:
DB_PASS=tu_password_seguro_aqui
DB_NAME=mesaayuda_db
DB_CONNECTION_LIMIT=20

# -----------------------------------------------------------------------------
# 3. Seguridad de Sesiones, Tokens JWT y PIN Maestro Administrativo
# -----------------------------------------------------------------------------
# IMPORTANTE: Generar una clave secreta aleatoria y robusta para producción.
# Ejemplo en terminal: openssl rand -base64 32
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_cambiar_en_produccion_2026
JWT_EXPIRES_IN=24h

# PIN maestro numérico requerido por el Administrador General para depuración y eliminación física de tickets
ADMIN_PURGE_PIN=1308

# -----------------------------------------------------------------------------
# 4. Almacenamiento de Archivos Adjuntos / File Server
# -----------------------------------------------------------------------------
# Ruta absoluta en el servidor para almacenar adjuntos de tickets (imágenes, PDFs, etc.)
# Ejemplo en servidor dedicado: /srv/repositorio/documentos o /var/www/mesa-ayuda/uploads
UPLOAD_DIR=/var/www/mesa-ayuda/uploads
# Tamaño máximo permitido por archivo (10485760 bytes = 10 MB)
MAX_FILE_SIZE_BYTES=10485760

# -----------------------------------------------------------------------------
# 5. Dominios, CORS y URLs de la Aplicación
# -----------------------------------------------------------------------------
# Orígenes permitidos en CORS (* para permitir todos o especificar el dominio del frontend)
ALLOWED_ORIGIN=*
# URL pública del portal web (utilizado para enlaces dentro de los correos automáticos)
APP_URL=https://mesadeayuda.tuentidad.gob.pe

# -----------------------------------------------------------------------------
# 6. Servicio de Notificaciones por Correo Electrónico (SMTP)
# -----------------------------------------------------------------------------
# Compatible con Google Workspace, Microsoft 365, Exchange o Relay SMTP Corporativo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true para puerto 465 (SSL directo), false para puerto 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=notificaciones.mesadeayuda@tuentidad.gob.pe
# Para Gmail Workspace, utilice una "Contraseña de aplicación" generada de 16 caracteres
SMTP_PASS=tu_password_o_app_password_aqui
SMTP_FROM="Mesa de Ayuda <notificaciones.mesadeayuda@tuentidad.gob.pe>"
# Correo institucional al que llegan las alertas de triage y solicitudes de alta
MESA_AYUDA_EMAIL=redes@tuentidad.gob.pe

# -----------------------------------------------------------------------------
# 7. Autenticación con Directorio Activo Institucional (Active Directory / LDAP)
# -----------------------------------------------------------------------------
# true = Permite a los usuarios autenticarse con sus cuentas de red de la entidad.
# false = Autenticación local mediante usuarios registrados en la base de datos MySQL.
LDAP_ENABLED=true

# URL del Domain Controller (DC). Se recomienda LDAPS cifrado en puerto 636:
# Ejemplos: ldaps://172.16.0.8:636  o  ldap://172.16.0.8:389
LDAP_URL=ldaps://172.16.0.8:636

# Base DN raíz del árbol del directorio activo donde se buscarán los usuarios
LDAP_BASE_DN=DC=tuentidad,DC=gob,DC=pe

# Dominio corporativo de la institución (sufijo UPN)
LDAP_DOMAIN=tuentidad.gob.pe

# Cuenta de servicio con permisos de lectura en Active Directory (Service Account / Bind User)
# Formato UPN: svc_mesadeayuda@tuentidad.gob.pe
# O formato DN: CN=svc_mesadeayuda,OU=Servicios,DC=tuentidad,DC=gob,DC=pe
LDAP_BIND_DN=svc_mesadeayuda@tuentidad.gob.pe

# Contraseña de la cuenta de servicio de Active Directory
LDAP_BIND_PASSWORD=password_cuenta_servicio_ldap

# Tiempo máximo de espera en milisegundos para consultas LDAP
LDAP_TIMEOUT_MS=6000
